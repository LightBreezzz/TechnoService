# TechnoService — переменные для Docker
# Скопируйте в .env и заполните: cp .env.example .env

# Django
DJANGO_SECRET_KEY=your-secret-key-min-50-chars-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (для docker-compose)
POSTGRES_DB=technoservice
POSTGRES_USER=technoservice
POSTGRES_PASSWORD=your-secure-password
